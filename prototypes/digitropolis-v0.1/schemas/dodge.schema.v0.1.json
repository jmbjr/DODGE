{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitropolis.example.invalid/schemas/dodge.schema.v0.1.json",
  "title": "DODGE v0.1 document",
  "description": "Declarative Object Description for Game Engines: a target-neutral object and scene manifest.",
  "type": "object",
  "required": ["dodge_version", "document_id", "game_id", "sources", "archetypes", "objects", "scenes"],
  "properties": {
    "dodge_version": {"const": "0.1.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "game_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "sources": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "archetypes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/archetype"}
    },
    "objects": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/object"}
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/scene"}
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "source": {
      "type": "object",
      "required": ["kind", "uri", "version"],
      "properties": {
        "kind": {"enum": ["entity_catalog", "selection_manifest", "rules", "text"]},
        "uri": {"type": "string"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "faceSlot": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["front", "back", "side", "outcome", "reference"]}
      },
      "additionalProperties": false
    },
    "archetype": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["token", "collection", "randomizer"]},
        "face_slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/faceSlot"}},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["entity_ref", "archetype_ref"],
      "properties": {
        "entity_ref": {"$ref": "#/$defs/ref"},
        "archetype_ref": {"$ref": "#/$defs/ref"},
        "quantity": {"type": "integer", "minimum": 1, "default": 1}
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["shuffle", "draw", "return", "select_uniform"]},
        "replacement": {"type": "boolean"},
        "destination": {"type": "string"}
      },
      "additionalProperties": false
    },
    "face": {
      "type": "object",
      "required": ["slot"],
      "properties": {
        "slot": {"$ref": "#/$defs/id"},
        "content_ref": {"type": "string"},
        "text": {"type": "string"}
      },
      "oneOf": [{"required": ["content_ref"]}, {"required": ["text"]}],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["kind", "archetype_ref"],
      "properties": {
        "kind": {"enum": ["token", "collection", "randomizer"]},
        "archetype_ref": {"$ref": "#/$defs/ref"},
        "name": {"type": "string"},
        "faces": {"type": "array", "items": {"$ref": "#/$defs/face"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "behaviors": {"type": "array", "items": {"$ref": "#/$defs/behavior"}},
        "source_ref": {"$ref": "#/$defs/ref"}
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["id", "object_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "object_ref": {"$ref": "#/$defs/ref"},
        "state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["name", "instances"],
      "properties": {
        "name": {"type": "string"},
        "instances": {"type": "array", "items": {"$ref": "#/$defs/instance"}}
      },
      "additionalProperties": false
    }
  }
}

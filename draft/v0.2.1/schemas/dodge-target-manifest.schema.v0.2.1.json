{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dodge-format.example.invalid/schemas/dodge-target-manifest.schema.v0.2.1.json",
  "title": "DODGE resolved target manifest 0.2.1 working draft",
  "type": "object",
  "required": ["manifest_version", "manifest_id", "target", "dodge_identity", "contract_identity", "resolution_scope", "contents"],
  "properties": {
    "manifest_version": {"const": "0.2.1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "dodge_identity": {
      "type": "object",
      "required": ["dodge_version", "document_id", "sha256"],
      "properties": {
        "dodge_version": {"const": "0.2.1"},
        "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "contract_identity": {
      "type": "object",
      "required": ["contract_version", "contract_id", "sha256"],
      "properties": {
        "contract_version": {"const": "0.2.1"},
        "contract_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "resolution_scope": {
      "type": "object",
      "required": ["scene_ref"],
      "properties": {
        "scene_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "scenario_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "campaign_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "runtime_state_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}
      },
      "additionalProperties": false
    },
    "contents": {"type": "array", "items": {"$ref": "#/$defs/contentEntry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["unit"],
      "properties": {
        "unit": {"enum": ["mm", "cm", "in", "pt"]},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "diameter": {"type": "number", "exclusiveMinimum": 0},
        "thickness": {"type": "number", "minimum": 0}
      },
      "anyOf": [{"required": ["width", "height"]}, {"required": ["diameter"]}],
      "additionalProperties": false
    },
    "componentMetadata": {
      "type": "object",
      "properties": {
        "form": {"enum": ["card", "token", "tile", "board", "reference_sheet", "tracker", "die", "standee", "custom"]},
        "size_class": {"type": "string"},
        "shape": {"enum": ["rectangle", "circle", "hex", "custom", "none"]},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "two_sided": {"type": "boolean"},
        "shared_back_ref": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "ref", "path"],
      "properties": {
        "kind": {"enum": ["scene-instance", "collection-member", "representation-component", "presentation-variant"]},
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "ref", "path"],
      "properties": {
        "kind": {"enum": ["dodge-document", "scene", "instance", "object", "archetype", "collection-member", "representation", "export-contract", "content-configuration", "presentation-variant"]},
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["field", "status", "classification"],
      "properties": {
        "field": {"enum": ["inclusion", "quantity", "component.dimensions", "component.size_class", "group", "presentation_variant", "notes"]},
        "status": {"enum": ["inherited", "derived", "overridden"]},
        "classification": {"enum": ["canonical", "presentation", "noncanonical-playtest"]},
        "canonical": {},
        "effective": {},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "overridden"}}, "required": ["status"]}, "then": {"required": ["effective", "reason"]}},
        {"if": {"properties": {"classification": {"const": "noncanonical-playtest"}}, "required": ["classification"]}, "then": {"required": ["reason"]}}
      ],
      "additionalProperties": false
    },
    "contentEntry": {
      "type": "object",
      "required": ["content_id", "source", "canonical_quantity", "resolved_quantity", "inclusion", "provenance", "diagnostics"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "parent_content_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "representation_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "representation_mode": {"enum": ["selected", "synchronized", "alternatives"]},
        "variant_of": {"type": "string", "minLength": 1},
        "canonical_quantity": {"type": "integer", "minimum": 0},
        "resolved_quantity": {"type": "integer", "minimum": 0},
        "inclusion": {"enum": ["included-inherited", "included-override", "excluded-override"]},
        "group": {"type": "string", "minLength": 1},
        "component_inherited": {"$ref": "#/$defs/componentMetadata"},
        "component_effective": {"$ref": "#/$defs/componentMetadata"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      },
      "allOf": [
        {"if": {"properties": {"inclusion": {"const": "excluded-override"}}, "required": ["inclusion"]}, "then": {"properties": {"resolved_quantity": {"const": 0}}}},
        {"if": {"required": ["variant_of"]}, "then": {"properties": {"source": {"properties": {"kind": {"const": "presentation-variant"}}}}}}
      ],
      "additionalProperties": false
    }
  }
}

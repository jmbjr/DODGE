{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dodge-format.example.invalid/schemas/dodge-export-contract.schema.v0.2.1.json",
  "title": "DODGE exporter contract 0.2.1 working draft",
  "type": "object",
  "required": ["contract_version", "contract_id", "target", "accepts", "maps", "adds", "outputs", "forbidden_in_dodge"],
  "properties": {
    "contract_version": {"const": "0.2.1"},
    "contract_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "accepts": {
      "type": "object",
      "required": ["dodge_versions", "object_kinds"],
      "properties": {
        "dodge_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "object_kinds": {"type": "array", "items": {"enum": ["token", "collection", "randomizer"]}, "uniqueItems": true},
        "component_forms": {"type": "array", "items": {"enum": ["card", "token", "tile", "board", "reference_sheet", "tracker", "die", "standee", "custom"]}, "uniqueItems": true},
        "representation_kinds": {"type": "array", "items": {"enum": ["unit_tokens", "numbered_track", "marker_track", "dial", "numeric_display", "status_marker", "target_native"]}, "uniqueItems": true},
        "representation_modes": {"type": "array", "items": {"enum": ["selected", "synchronized", "alternatives"]}, "uniqueItems": true},
        "rule_features": {"type": "array", "items": {"enum": ["values", "resources", "ownership_bindings", "conditions", "effects", "timing", "usage_limits", "transformations", "actions", "invocations", "procedures", "phases", "ai_profiles", "topologies", "topology_materialization", "scenarios", "campaigns"]}, "uniqueItems": true},
        "allows_prose_rules": {"type": "boolean", "default": false},
        "required_extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "maps": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "notes": {"type": "string"}}, "additionalProperties": false}},
    "adds": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "forbidden_in_dodge": {"type": "array", "items": {"type": "string"}},
    "representation_inclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state_ref", "mode", "representation_refs"],
        "properties": {
          "state_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "mode": {"enum": ["selected", "synchronized", "alternatives"]},
          "representation_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}, "uniqueItems": true},
          "notes": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"mode": {"const": "selected"}}, "required": ["mode"]}, "then": {"properties": {"representation_refs": {"maxItems": 1}}}},
          {"if": {"properties": {"mode": {"enum": ["synchronized", "alternatives"]}}, "required": ["mode"]}, "then": {"properties": {"representation_refs": {"minItems": 2}}}}
        ],
        "additionalProperties": false
      }
    },
    "content_configuration": {"$ref": "#/$defs/contentConfiguration"},
    "manifest_identity_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["unit"],
      "properties": {
        "unit": {"enum": ["mm", "cm", "in", "pt"]},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "diameter": {"type": "number", "exclusiveMinimum": 0},
        "thickness": {"type": "number", "minimum": 0}
      },
      "anyOf": [{"required": ["width", "height"]}, {"required": ["diameter"]}],
      "additionalProperties": false
    },
    "componentOverrides": {
      "type": "object",
      "properties": {
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "size_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "quantityOverride": {
      "type": "object",
      "required": ["value", "classification", "reason"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "classification": {"const": "noncanonical-playtest"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "presentationVariant": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "label": {"type": "string", "minLength": 1},
        "component_overrides": {"$ref": "#/$defs/componentOverrides"},
        "quantity_override": {"$ref": "#/$defs/quantityOverride"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "contentOverride": {
      "type": "object",
      "required": ["content_ref"],
      "properties": {
        "content_ref": {"type": "string", "minLength": 1},
        "inclusion": {"enum": ["inherit", "include", "exclude"]},
        "group": {"type": "string", "minLength": 1},
        "component_overrides": {"$ref": "#/$defs/componentOverrides"},
        "quantity_override": {"$ref": "#/$defs/quantityOverride"},
        "variant_policy": {"enum": ["replace-base", "alongside-base"]},
        "presentation_variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/presentationVariant"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"required": ["presentation_variants"]}, "then": {"required": ["variant_policy"]}},
        {"if": {"required": ["variant_policy"]}, "then": {"required": ["presentation_variants"]}}
      ],
      "additionalProperties": false
    },
    "contentConfiguration": {
      "type": "object",
      "required": ["default_inclusion", "entries"],
      "properties": {
        "default_inclusion": {"const": "inherit-resolved"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/contentOverride"}}
      },
      "additionalProperties": false
    }
  }
}

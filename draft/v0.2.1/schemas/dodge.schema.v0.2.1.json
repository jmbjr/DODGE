        "tags": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "generationDecision": {
      "type": "object",
      "required": ["sequence", "event"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "event": {"$ref": "#/$defs/id"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "required": ["source_topology_ref", "generation_id", "id_policy"],
      "properties": {
        "source_topology_ref": {"$ref": "#/$defs/ref"},
        "generation_id": {"$ref": "#/$defs/id"},
        "generation_procedure_ref": {"$ref": "#/$defs/ref"},
        "seed": {"type": ["string", "integer"]},
        "generator_version": {"type": "string"},
        "id_policy": {"enum": ["stable-derived", "stable-recorded"]},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/generationDecision"}},
        "state_revision": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "topology": {
      "type": "object", "required": ["name", "resolution"],
      "properties": {
        "name": {"type": "string"}, "description": {"type": "string"}, "resolution": {"enum": ["unresolved", "partially-materialized", "materialized"]},
        "generation_procedure_ref": {"$ref": "#/$defs/ref"}, "component_pool": {"type": "array", "items": {"$ref": "#/$defs/topologyPool"}},
        "constraints": {"type": "array", "items": {"type": "string"}}, "hidden_state_policy": {"type": "string"},
        "id_policy": {"enum": ["stable-derived", "stable-recorded"]},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/topologyNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/topologyEdge"}}, "materialization": {"$ref": "#/$defs/materialization"},
        "source_ref": {"$ref": "#/$defs/ref"},
        "authority": {"$ref": "#/$defs/authority"}, "assumptions": {"type": "array", "items": {"type": "string"}}, "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {"if": {"properties": {"resolution": {"const": "unresolved"}}}, "then": {"required": ["generation_procedure_ref"]}},
        {"if": {"properties": {"resolution": {"const": "materialized"}}}, "then": {"required": ["nodes", "edges", "materialization"]}}
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object", "required": ["id", "name", "completion"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "description": {"type": "string"}, "required": {"type": "boolean", "default": true},
        "completion": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/condition"}]}, "effect_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "endCondition": {
      "type": "object", "required": ["id", "outcome", "condition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["win", "loss", "retreat", "draw", "continue", "custom"]},
        "condition": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/condition"}]}, "effect_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "priority": {"type": "integer"}, "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object", "required": ["ref", "value"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "subject": {"$ref": "#/$defs/subject"}, "value": {}, "authority": {"$ref": "#/$defs/authority"}},
      "additionalProperties": false
    },
    "clockState": {
      "type": "object",
      "properties": {

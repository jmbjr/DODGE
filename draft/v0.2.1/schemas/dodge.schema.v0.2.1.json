        "active_subject": {"$ref": "#/$defs/subject"}
      },
      "additionalProperties": false
    },
    "activeEffectState": {
      "type": "object",
      "required": ["id", "effect_ref", "subject"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "effect_ref": {"$ref": "#/$defs/ref"}, "subject": {"$ref": "#/$defs/subject"},
        "source_subject": {"$ref": "#/$defs/subject"}, "applied_at": {"$ref": "#/$defs/timingAnchor"},
        "expires_at": {"$ref": "#/$defs/timingAnchor"}, "remaining_uses": {"type": "integer", "minimum": 0},
        "cause_ref": {"$ref": "#/$defs/ref"}, "state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "scheduledEffectState": {
      "type": "object",
      "required": ["id", "effect_ref", "subject", "at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "effect_ref": {"$ref": "#/$defs/ref"}, "subject": {"$ref": "#/$defs/subject"},
        "source_subject": {"$ref": "#/$defs/subject"}, "at": {"$ref": "#/$defs/timingAnchor"},
        "cause_ref": {"$ref": "#/$defs/ref"}, "captured_bindings": {"type": "object"}, "state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "runtimeEvent": {
      "type": "object", "required": ["sequence", "event"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0}, "event": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/subject"}, "cause_ref": {"$ref": "#/$defs/ref"}, "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "runtimeState": {
      "type": "object",
      "properties": {
        "scene_ref": {"$ref": "#/$defs/ref"}, "scenario_ref": {"$ref": "#/$defs/ref"}, "campaign_ref": {"$ref": "#/$defs/ref"},
        "clock": {"$ref": "#/$defs/clockState"}, "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "active_effects": {"type": "array", "items": {"$ref": "#/$defs/activeEffectState"}},
        "scheduled_effects": {"type": "array", "items": {"$ref": "#/$defs/scheduledEffectState"}},
        "materialized_topology_ref": {"$ref": "#/$defs/ref"}, "events": {"type": "array", "items": {"$ref": "#/$defs/runtimeEvent"}},
        "revision": {"type": "string"}, "extensions": {"$ref": "#/$defs/extensions"}
      },
      "anyOf": [{"required": ["scene_ref"]}, {"required": ["scenario_ref"]}, {"required": ["campaign_ref"]}],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object", "required": ["name", "scene_ref"],
      "properties": {
        "name": {"type": "string"}, "description": {"type": "string"}, "scene_ref": {"$ref": "#/$defs/ref"}, "topology_ref": {"$ref": "#/$defs/ref"},
        "materialized_topology_ref": {"$ref": "#/$defs/ref"},
        "players": {"type": "object", "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "initial_state": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "action_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "turn_procedure_ref": {"$ref": "#/$defs/ref"}, "objectives": {"type": "array", "items": {"$ref": "#/$defs/objective"}},
        "end_conditions": {"type": "array", "items": {"$ref": "#/$defs/endCondition"}},
        "target_duration_minutes": {"type": "object", "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "source_ref": {"$ref": "#/$defs/ref"}, "authority": {"$ref": "#/$defs/authority"}, "assumptions": {"type": "array", "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "campaignLocation": {
      "type": "object", "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "scenario_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "state": {"type": "object"}},
      "additionalProperties": false
    },
    "campaign": {
      "type": "object", "required": ["name"],
      "properties": {
        "name": {"type": "string"}, "description": {"type": "string"}, "persistent_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "phase_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "progression_procedure_ref": {"$ref": "#/$defs/ref"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/campaignLocation"}}, "terminal_conditions": {"type": "array", "items": {"$ref": "#/$defs/endCondition"}},
        "source_ref": {"$ref": "#/$defs/ref"}, "authority": {"$ref": "#/$defs/authority"}, "assumptions": {"type": "array", "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }

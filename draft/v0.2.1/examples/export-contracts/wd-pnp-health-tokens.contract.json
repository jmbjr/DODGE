{
  "contract_version": "0.2.1",
  "contract_id": "wd-pnp-health-tokens",
  "target": "pnp",
  "accepts": {
    "dodge_versions": ["0.2.1"],
    "object_kinds": ["token", "collection", "randomizer"],
    "component_forms": ["card", "token", "tile", "reference_sheet", "tracker"],
    "representation_kinds": ["unit_tokens"],
    "rule_features": ["values", "resources", "ownership_bindings"]
  },
  "maps": [{"from": "representations.health-unit-tokens", "to": "printable token sheet"}],
  "adds": ["page imposition", "cut marks", "bleed", "printer instructions"],
  "outputs": ["PDF"],
  "forbidden_in_dodge": ["PDF coordinates", "cut-mark geometry", "font sizes", "printer settings"],
  "representation_selections": [{"state_ref": "health", "representation_ref": "health-unit-tokens"}],
  "manifest_identity_fields": ["DODGE SHA-256", "contract ID", "state ref", "representation ref"]
}
